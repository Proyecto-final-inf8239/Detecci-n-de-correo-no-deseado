# Datos: NO se suben a Git. Cada persona los obtiene con src/data/adquirir.py
data/raw/*
!data/raw/.gitkeep
*.zip

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# Entorno y sistema
.env
.DS_Store
Thumbs.db
.vscode/
.idea/

# Modelos entrenados y registros de predicciones, fuera de Git
artefactos/*
!artefactos/.gitkeep
logs/*
!logs/.gitkeep
